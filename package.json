    "check:missions": "tsx scripts/check-missions.mjs",
    "check:save": "tsx scripts/check-save.mjs",
    "check:interiors": "tsx scripts/check-interiors.mjs",
    "check:map-layout": "tsx scripts/check-map-layout.mjs",
    "check:roads": "tsx scripts/check-roads.mjs",
    "check:buildings": "tsx scripts/check-buildings.mjs",
    "check:anchors": "tsx scripts/check-anchors.mjs",
    "check:vegetation": "tsx scripts/check-vegetation.mjs",
    "check:grass-grounding": "tsx scripts/check-grass-grounding.mjs",
    "check:prop-grounding": "tsx scripts/check-prop-grounding.mjs",
    "check:nav-graph": "tsx scripts/check-nav-graph.mjs",
    "check:instance-attrs": "tsx scripts/check-instance-attrs.mjs",
